# ── 중간 JSON 파일 (workspace/) ──────────────────────────────────────
workspace/**/*.json
workspace/*/

# workspace/ README는 유지
!workspace/README.md

# ── Python 도구 ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# ── Node.js ───────────────────────────────────────────────────────────
node_modules/

# ── macOS ─────────────────────────────────────────────────────────────
.DS_Store

# ── 임시 파일 ────────────────────────────────────────────────────────
*.tmp
*.bak
.claude/worktrees/

# 도구 캐시
.serena/

# ── 교사용 지도서 ─────────────────────────────────────────────────────
# 용량이 커서(약 52MB) 저장소에 넣지 않는다.
# 새 기기에서는 Google Drive에서 복사할 것 — README '다른 기기에서 작업하기' 참조.
*/book/지도서/

# 공유용 빌드 산출물 (tools/build_share_package.py 가 생성)
dist/

# ── Windows ───────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Cowork 가 대화로 보낸 파일을 자동 저장하는 폴더
Claude outputs/

# 시험지 작업 중 생긴 임시 추출 파일
_q2*.svg
_k_block.txt
ai-math/book/_pg-*.png
